FROM artifactory.laforge.local.fr/docker-io/nginx:1.31.3-alpine3.24-slim

EXPOSE 8080

# Mise à jour uniquement depuis les repositories Alpine 3.24
RUN apk upgrade --no-cache

COPY nginx.conf /etc/nginx/nginx.conf
COPY default.conf /etc/nginx/conf.d/default.conf

RUN chgrp -R 0 /var/run/ && \
    chgrp -R 0 /var/cache/ && \
    chmod -R g+rwX /var/run/ && \
    chmod -R a+rwX /var/run/ && \
    chmod -R a+rwX /var/cache/ && \
    chmod -R g+rwX /var/cache/

COPY target /usr/share/nginx/html/myAppEn

